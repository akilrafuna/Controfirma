# Copy to .env and fill in your own key. Never commit the real file.
#
# Works with any OpenAI-compatible endpoint, which is what both AMD Token Factory
# and a self-hosted vLLM server on AMD Developer Cloud expose. Moving from a hosted
# Instinct GPU to our own is this one variable.
#
# Get a key at notebooks.amd.com/tokenfactory. Run `node src/findendpoint.js` if the
# base URL ever moves, and `node src/probe.js` to list the models actually served.

AMD_API_KEY=
AMD_BASE_URL=https://developer.amd.com.cn/radeon/api/v1

# Benchmarked across six served models (node src/benchmark.js): fastest that passed
# verification. Reasoning models return empty at a live-call token budget.
AMD_MODEL=Gemma-4-31B-IT

# The shared event endpoint answers 429 above roughly three requests per second.
# On a dedicated vLLM server these are yours to raise.
AMD_CONCURRENCY=3
AMD_MIN_INTERVAL_MS=350

# Without AMD_API_KEY the pipeline runs against a mock. The rules and the verifier
# are real in both modes; only the explanation text is a stand-in.

PORT=3000
